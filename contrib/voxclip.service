[Unit]
Description=VoxClip — Voice-to-Clipboard daemon
Documentation=https://github.com/voxclip/voxclip
PartOf=graphical-session.target
After=graphical-session.target
Wants=pipewire.service

[Service]
Type=simple
ExecStart=%h/.local/bin/voxclip daemon
Restart=on-failure
RestartSec=5
PassEnvironment=WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_RUNTIME_DIR

# Resource limits
MemoryMax=3G
CPUQuota=200%

[Install]
WantedBy=default.target
